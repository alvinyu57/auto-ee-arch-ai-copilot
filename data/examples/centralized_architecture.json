      "associated_components": [
        "front-camera",
        "adas"
      ],
      "constraints": {
        "kind": "connectivity",
        "source_device_id": "front-camera",
        "destination_device_id": "adas"
      }
    },
    {
      "id": "REQ-CONN-002",
      "description": "Synthetic: body controller must physically connect to the gateway.",
      "requirement_type": "connectivity",
      "associated_components": [

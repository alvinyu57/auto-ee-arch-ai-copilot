        "infotainment"
      ],
      "constraints": {
        "kind": "isolation",
        "source_device_id": "front-camera",
        "destination_device_id": "infotainment"
      }
    },
    {
      "id": "REQ-TEXT-001",
      "description": "Synthetic free text: camera delivery latency should be reviewed by an engineer.",

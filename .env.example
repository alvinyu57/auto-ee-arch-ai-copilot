# Offline retrieval defaults. No keys or model download needed.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=hash-token-v1
EMBEDDING_DIMENSION=384
VECTOR_DB_PATH=data/vector_db
RETRIEVAL_TOP_K=5
SEMANTIC_TOP_K=12
KEYWORD_TOP_K=12
RRF_CONSTANT=60
MIN_SIMILARITY=0.15
ENABLE_RERANKING=false
CHUNK_SIZE=1000
CHUNK_OVERLAP=120
MAX_REQUEST_BYTES=1100000

# Real embeddings: select openai_compatible and an installed model and its output dimension.
# Changing provider/model/dimension requires a new index path and corpus reingestion.
EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=32

# Optional generation. A running compatible server must support chat/completions JSON output.
LLM_PROVIDER=none
LLM_MODEL=
LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
PROVIDER_TIMEOUT_SECONDS=30

# Read-only agent. Reuses LLM_BASE_URL and LLM_API_KEY; AGENT_MODEL falls back to LLM_MODEL.
# Select openai_compatible only with a model supporting native function calls and JSON output.
# Scripted providers are test-only and cannot be selected here.
AGENT_PROVIDER=none
AGENT_MODEL=
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOOL_CALLS=10
AGENT_TIMEOUT_SECONDS=60
AGENT_TOOL_TIMEOUT_SECONDS=10
AGENT_MAX_TOOL_RESULT_BYTES=16384
AGENT_MAX_ARGUMENT_BYTES=4096
AGENT_MAX_CONTEXT_BYTES=131072
AGENT_MAX_PROVIDER_RESPONSE_BYTES=262144
AGENT_ENABLE_TRACING=true
AGENT_MAX_OUTPUT_TOKENS=2000

# Optional explicit USD prices for the configured agent model; configure both or neither.
# Estimates require complete provider token usage. No built-in prices or fabricated costs.
# AGENT_INPUT_USD_PER_MILLION_TOKENS=
# AGENT_OUTPUT_USD_PER_MILLION_TOKENS=
